{
  "name": "reacher",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first Windows desktop OSINT and cybersecurity app.",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:main && vite build",
    "build:main": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json && npm run build:preload",
    "build:preload": "esbuild src/preload/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload/preload.cjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.preload.json",
    "lint": "eslint .",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm test && npm run audit:security && node scripts/phase-audit.mjs 14",
    "audit:security": "node scripts/audit-security.mjs",
    "package:dir": "npm run build && electron-builder --dir --publish never",
    "package:win": "npm run build && electron-builder --win --publish never",
    "package:smoke": "node scripts/package-smoke.mjs"
  },
  "keywords": [
    "osint",
    "cybersecurity",
    "electron"
  ],
  "author": "",
  "license": "UNLICENSED",
  "build": {
    "appId": "local.reacher.desktop",
    "productName": "Reacher",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json",
      "assets/brand/**"
    ],
    "extraResources": [
      {
        "from": "assets/brand",
        "to": "assets/brand"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/brand/reacher-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@xyflow/react": "^12.11.2",
    "better-sqlite3": "^13.0.3",
    "docx": "^9.7.1",
    "fast-xml-parser": "^5.10.1",
    "libsodium-wrappers": "^0.8.4",
    "lucide-react": "^1.31.0",
    "pdfkit": "^0.19.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^26.2.0",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
